# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# An address on a domain you have verified in Mailtea.
MAILTEA_FROM=Acme <hello@acme.com>

# Where this example sends to.
MAILTEA_TO=you@your-domain.com

# Only for local dev or a self-hosted Mailtea. Leave unset in production.
# MAILTEA_API_BASE_URL=https://mailtea.your-domain.com
